<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><StartupObject>RemovalNullBootstrap</StartupObject>
    <RepositoryRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../..'))</RepositoryRoot>
    <ModAssemblyPath Condition="'$(ModAssemblyPath)' == ''">$(RepositoryRoot)/libs/HBRGOSakiMod.dll</ModAssemblyPath>
    <NativeAssemblyPath Condition="'$(NativeAssemblyPath)' == ''">$(RepositoryRoot)/libs/sts2.dll</NativeAssemblyPath>
    <NativeRitsuAssemblyPath Condition="'$(NativeRitsuAssemblyPath)' == ''">$(RepositoryRoot)/libs/STS2-RitsuLib.dll</NativeRitsuAssemblyPath>
    <BaseLibAssemblyPath Condition="'$(BaseLibAssemblyPath)' == ''">$(RepositoryRoot)/libs/BaseLib.dll</BaseLibAssemblyPath>
    <GodotSharpAssemblyPath Condition="'$(GodotSharpAssemblyPath)' == ''">C:/Users/ROG/.nuget/packages/godotsharp/4.5.1/lib/net8.0/GodotSharp.dll</GodotSharpAssemblyPath>
    <DefineConstants Condition="'$(BetaNativeChecks)' == 'true'">$(DefineConstants);HBR_BETA_NATIVE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../hbr-effect-skill-damage/*.cs" Link="EffectHost/%(Filename)%(Extension)" />
    <Compile Include="../hbr-stat-powers/Program.cs" Link="StatHost.cs" />
    <Reference Include="HBRGOSakiMod" HintPath="$(ModAssemblyPath)" Private="false" />
    <Reference Include="sts2" HintPath="$(NativeAssemblyPath)" Private="false" />
    <Reference Include="BaseLib" HintPath="$(BaseLibAssemblyPath)" Private="false" />
    <Reference Include="STS2-RitsuLib" HintPath="$(NativeRitsuAssemblyPath)" Private="false" />
    <Reference Include="0Harmony" HintPath="$(RepositoryRoot)/libs/0Harmony.dll" />
    <Reference Include="GodotSharp" HintPath="$(GodotSharpAssemblyPath)" Private="false" />
  </ItemGroup>
</Project>
