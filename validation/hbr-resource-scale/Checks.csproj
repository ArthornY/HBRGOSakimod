<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><StartupObject>Bootstrap</StartupObject>
    <RepositoryRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../..'))</RepositoryRoot>
    <ModAssemblyPath Condition="'$(ModAssemblyPath)' == ''">$(RepositoryRoot)/.godot/mono/temp/bin/Release/HBRGOSakiMod.dll</ModAssemblyPath>
    <GodotSharpAssemblyPath Condition="'$(GodotSharpAssemblyPath)' == ''">$(NuGetPackageRoot)godotsharp/4.5.1/lib/net8.0/GodotSharp.dll</GodotSharpAssemblyPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../hbr-enemy-resources/Bootstrap.cs" Link="Bootstrap.cs" />
    <Reference Include="HBRGOSakiMod" HintPath="$(ModAssemblyPath)" Private="false" />
    <Reference Include="sts2" HintPath="$(RepositoryRoot)/libs/sts2.dll" Private="false" />
    <Reference Include="BaseLib" HintPath="$(RepositoryRoot)/libs/BaseLib.dll" Private="false" />
    <Reference Include="STS2-RitsuLib" HintPath="$(RepositoryRoot)/libs/STS2-RitsuLib.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(RepositoryRoot)/libs/0Harmony.dll" />
    <Reference Include="GodotSharp" HintPath="$(GodotSharpAssemblyPath)" Private="false" />
  </ItemGroup>
</Project>
