ker":"","text":"立希","portrait":"","background":"","portraitLayout":null,"characters":null}],"choices":[{"id":"CHOICE","text":"获得8点领袖魅力，从3张卡牌中选择1张获得","description":"获得8点领袖魅力，从3张卡牌中选择1张获得","nextPage":"SCENE","rewards":{"sense":"LeadershipCharm","senseAmount":8,"cardChoices":3}}],"characters":[],"metCharacters":["taki"],"title":"椎名立希"},{"id":"KAREN","title":"朝仓可怜","choicePrompt":"","background":"","lines":[{"kind":"narration","speaker":"","text":"朝仓可怜","portrait":"","background":"","portraitLayout":null,"characters":null}],"characters":[],"metCharacters":["karen"],"choices":[{"id":"TAKE_REWARD","text":"疯狂+8，从3张卡牌中选择1张获得。","description":"疯狂+8，从3张卡牌中选择1张获得。","nextPage":"SCENE","rewards":{"sense":"Madness","senseAmount":8,"cardChoices":3}}]},{"id":"SCENE","title":"ENDING","choicePrompt":"","background":"","lines":[],"choices":[],"characters":[]}]},"library":{"schemaVersion":1,"id":"LIBRARY_HBRGO_SAKI","title":"图书馆","eventPool":"memoryFragments","conditions":{"partyCharacters":["HbrgoSaki31O","HbrgoSaki30A","HbrgoHotaru"],"acts":[],"oncePerRun":true,"afterEventIds":["JOINING_CEREMONY_HBRGO_SAKI"]},"presentation":{"background":"res://images/events/hbrgo_saki_mod_event_library_hbrgo_saki.png","dialogueStyle":"original","choicePortrait":"res://images/characters/hbrgo_saki_normal.png","thoughtPortrait":"","portraitLayout":{"x":47.1,"y":679.8,"size":184,"imageScale":2.95,"imageOffsetX":-6,"imageOffsetY":336.9}},"startPage":"INITIAL","pages":[{"id":"INITIAL","choicePrompt":"读些什么呢？","background":"","lines":[{"kind":"narration","speaker":"","text":"又一场战斗结束后，你的脑袋突然剧烈的疼痛起来。","portrait":"","background":"res://images/story/ae18a9c23d806d4f878b.png","portraitLayout":null,"characters":[]},{"kind":"narration","speaker":"","text":"闭上眼，再睁开时，你发现自己竟然身处一座图书馆？","portrait":"","background":"res://images/events/hbrgo_saki_mod_event_library_hbrgo_saki.png","portraitLayout":null,"characters":null},{"kind":"narration","speaker":"","text":"你下意识的从面前的书架上拿起了一本书。","portrait":"","background":"","portraitLayout":null,"characters":null}],"choices":[{"id":"PETS","text":"杂志（宠物特辑）","description":"温柔＋8，从3张卡牌中选择1张获得。","nextPage":"PETS","rewards":{"sense":"","senseAmount":0,"cardChoices":0}},{"id":"MODELS","text":"杂志（模特特辑）","description":"才能＋8，从3张卡牌中选择1张获得。","nextPage":"MODELS","rewards":{"sense":"","senseAmount":0,"cardChoices":0}},{"id":"ROMANCE","text":"恋爱小说","description":"精神＋8，从3张卡牌中选择1张获得。","nextPage":"ROMANCE","rewards":{"sense":"","senseAmount":0,"cardChoices":0}},{"id":"CHOICE","text":"睦","description":"才能+8，从3张卡牌中选择1张获得","nextPage":"MUTSUMI","rewards":{"sense":"Talent","senseAmount":8,"cardChoices":3}}],"characters":[]},{"id":"PETS","choicePrompt":"","background":"","lines":[{"kind":"narration","speaker":"","text":"杂志的封面上印着一只粉色的小狗。你原本只是随手翻阅，却不知不觉在那些小动物的照片上停留了许久。","portrait":"","background":"","portraitLayout":null,"characters":null},{"kind":"thought","speaker":"","text":"（……很可爱呢。）","portrait":"","background":"","portraitLayout":null,"characters":null},{"kind":"thought","speaker":"","text":"（再看一会儿，应该也没关系吧。）","portrait":"","background":"","portraitLayout":null,"characters":null},{"kind":"narration","speaker":"","text":"纸页轻轻翻动，连日战斗带来的紧绷也随之松弛下来。","portrait":"","background":"","portraitLayout":null,"characters":null},{"kind":"dialogue","speaker":"","text":"嗷呜……","portrait":"","background":"","portraitLayout":{"x":47.1,"y":679.8,"size":184,"imageScale":1,"imageOffsetX":-6,"imageOffsetY":4.6},"characters":null},{"kind":"narration","speaker":"","text":"你循声望去。一只白虎正伏在不远处的少女身旁，其中一只眼睛似乎已经失明。","portrait":"","background":"","portraitLayout":null,"characters":[{"id":"CHARACTER","image":"res://images/story/12fb4370cf41a16d4ea7.png","x":684.4,"y":921.7,"height":820,"flipX":false,"opacity":1}]},{"kind":"thought","speaker":"","text":"（……白虎？）","portrait":"","background":"","portraitLayout":null,"characters":null},{"kind":"thought","speaker":"","text":"（为什么图书馆里会有白虎……而且，未免也太自然了些吧。）","portrait":"","background":"","portraitLayout":null,"characters":null},{"kind":"narration","speaker":"","text":"正当你这样想着，少女轻柔的声音传了过来。","portrait":"","background":"","portraitLayout":null,"characters":[]},{"kind":"dialogue","speaker":"记忆力很好的少女","text":"嗯，真让人怀念啊。白虎，这是你小时候的照片哦。","portrait":"","background":"","portraitLayout":{"x":47.1,"y":679.8,"size":184,"imageScale":1,"imageOffsetX":15.6,"imageOffsetY":102.1},"characters":[{"id":"CHARACTER","image":"res://images/story/1773ddfe2e21c0cffaf9.png","x":496.6,"y":910.8,"height":820,"flipX":false,"opacity":1},{"id":"CHARACTER_2","image":"res://images/story/4fbccf270e4e558dd149.png","x":1092.5,"y":921.6,"height":820,"flipX":false,"opacity":1}]},{"kind":"thought","speaker":"","text":"（原来名字也叫白虎……稍微有些直白呢。）","portrait":"","background":"","portraitLayout":null,"characters":null},{"kind":"narration","speaker":"","text":"你顺着少女的目光低下头，这才发觉，她和白虎看的，竟然也是你手中的这本杂志。","portrait":"","background":"","portraitLayout":null,"characters":[]},{"kind":"narration","speaker":"","text":"摊开的书页上，一只小小的白色幼兽蜷成一团。","portrait":"","background":"","portraitLayout":null,"characters":null},{"kind":"thought","speaker":"","text":"（……等等。她说的，难道是这一只？）","portrait":"","background":"","portraitLayout":null,"characters":null},{"kind":"narration","speaker":"","text":"你看了看照片，又看了看少女身旁的白虎。","portrait":"","background":"","portraitLayout":null,"characters":[{"id":"CHARACTER","image":"res://images/story/12fb4370cf41a16d4ea7.png","x":604.9,"y":1293.6,"height":1295,"flipX":false,"opacity":1}]},{"kind":"thought","speaker":"","text":"（怎么看都还是只小猫呢……居然会长得这么大啊。）","portrait":"","background":"","portraitLayout":null,"characters":null},{"kind":"narration","speaker":"","text":"少女轻轻抚摸着白虎的背，白虎则发出低低的呼噜声。你望着这一幕，唇角不自觉地浮起了一点笑意。","portrait":"","background":"","portraitLayout":null,"characters":[{"id":"CHARACTER","image":"res://images/story/1773ddfe2e21c0cffaf9.png","x":511.1,"y":925.3,"height":820,"flipX":false,"opacity":1},{"id":"CHARACTER_2","image":"res://images/story/4fbccf270e4e558dd149.png","x":854.2,"y":921.7,"height":820,"flipX":false,"opacity":1}]},{"kind":"thought","speaker":"","text":"（……连自己小时候的照片，也能认出来么。）","portrait":"","background":"","portraitLayout":null,"characters":null},{"kind":"thought","speaker":"","text":"（真是个聪明的孩子呢。）","portrait":"","background":"","portraitLayout":null,"characters":null},{"kind":"narration","speaker":"","text":"一种莫名的安心感涌上心头。可就在你试图抓住那份熟悉的感觉时，脑海中忽然传来一阵刺痛。","portrait":"","background":"res://images/story/ae18a9c23d806d4f878b.png","portraitLayout":null,"characters":[]},{"kind":"narration","speaker":"","text":"再次睁眼，面前已是塔内冰冷的墙壁。","portrait":"","background":"res://images/story/94f82a588fa5f0bb389a.png","portraitLayout":null,"characters":null},{"kind":"thought","speaker":"","text":"（刚才的……究竟是什么？）","portrait":"","background":"","portraitLayout":null,"characters":null},{"kind":"thought","speaker":"","text":"（那个女孩，还有白虎……明明想不起在哪里见过，为什么会觉得这样怀念呢。）","portrait":"","background":"","portraitLayout":null,"characters":null}],"choices":[{"id":"TAKE_REWARD","text":"温柔＋8，从3张卡牌中选择1张获得。","description":"温柔＋8，从3张卡牌中选择1张获得。","nextPage":"FINISHED","rewards":{"sense":"Gentleness","senseAmount":8,"cardChoices":3}}],"characters":[],"metCharacters":["erika","byakko"]},{"id":"MODELS","choicePrompt":"","background":"","lines":[{"kind":"thought","speaker":"","text":"（……写真杂志？这种地方，居然也会有这些啊。）","portrait":"","background":"","portraitLayout":null,"characters":null},{"kind":"narration","speaker":"","text":"你略一迟疑，还是翻开了杂志。","portrait":"","background":"","portraitLayout":null,"characters":null},{"kind":"thought","speaker":"","text":"（……这、这身衣服，不纯desuwa！）","portrait":"","background":"","portraitLayout":null,"characters":null},{"kind":"narration","speaker":"","text":"指尖停在了书页的一角。","portrait":"","background":"","portraitLayout":null,"characters":null},{"kind":"thought","speaker":"","text":"（不过……她穿起来的话，应该会很合适呢。）","portrait":"","background":"","portraitLayout":null,"characters":null},{"kind":"thought","speaker":"","text":"（下次让她试试看好了——）","portrait":"","background":"","portraitLayout":null,"characters":null},{"kind":"thought","speaker":"","text":"（……她？）","portrait":"","background":"","portraitLayout":null,"characters":null},{"kind":"narration","speaker":"","text":"刚刚还十分自然的念头，忽然变得陌生起来。","portrait":"","background":"","portraitLayout":null,"characters":null},{"kind":"narration","speaker":"","text":"你试着回想，脑海中却只有一抹模糊的粉色。","portrait":"","background":"","portraitLayout":null,"characters":null},{"kind":"narration","speaker":"","text":"明明连对方穿上那身衣服时，自己会是什么心情都隐约记得，却怎么也想不起她的面容。","portrait":"","background":"","portraitLayout":null,"characters":null},{"kind":"thought","speaker":"","text":"（……真是的。这种事情，怎么能忘记呢。）","portrait":"","background":"","portraitLayout":null,"characters":null},{"kind":"narration","speaker":"","text":"你有些焦躁地翻过一页，又翻过一页。杂志上的模特已无暇细看，直到一张照片让你的指尖猛地停住。","portrait":"","background":"","portraitLayout":null,"characters":null},{"kind":"thought","speaker":"","text":"（……等等。这位紫发的女性……）","portrait":"","background":"","portraitLayout":null,"characters":null},{"kind":"narration","speaker":"","text":"照片上的面容，渐渐与记忆中一道身影重叠起来。","portrait":"","background":"","portraitLayout":null,"characters":null},{"kind":"thought","speaker":"","text":"（是“入队仪式”时，穿着军装站在演讲台上的那位吧？）","portrait":"","background":"","portraitLayout":null,"characters":null},{"kind":"thought","speaker":"","text":"（……为什么会在写真杂志里看到她啊。）","portrait":"","background":"","portraitLayout":null,"characters":null},{"kind":"narration","speaker":"","text":"一瞬间，连刚才的焦躁都被挤到了一旁。你重新看向照片，试图回忆她当时说过的话。","portrait":"","background":"","portraitLayout":null,"characters":null},{"kind":"thought","speaker":"","text":"（我记得，那时候她——）","portrait":"","background":"","portraitLayout":null,"characters":null},{"kind":"narration","speaker":"","text":"脑海中忽然传来一阵刺痛。","portrait":"","background":"res://images/story/ae18a9c23d806d4f878b.png","portraitLayout":null,"characters":null},{"kind":"narration","speaker":"","text":"再次睁眼，面前已是塔内冰冷的墙壁。","portrait":"","background":"res://images/story/94f82a588fa5f0bb389a.png","portraitLayout":null,"characters":null},{"kind":"thought","speaker":"","text":"（……又是这样。）","portrait":"","background":"","portraitLayout":null,"characters":null},{"kind":"narration","speaker":"","text":"你按着额角，试着留住那些正在散去的印象。","portrait":"","background":"","portraitLayout":null,"characters":null},{"kind":"thought","speaker":"","text":"（那道粉色的身影，还有穿着军装的那位……）","portrait":"","background":"","portraitLayout":null,"characters":null},{"kind":"thought","speaker":"","text":"（明明应该记得的。为什么……偏偏想不起她们是谁呢。）","portrait":"","background":"","portraitLayout":null,"characters":null}],"choices":[{"id":"TAKE_REWARD","text":"才能＋8，从3张卡牌中选择1张获得。","description":"才能＋8，从3张卡牌中选择1张获得。","nextPage":"FINISHED","rewards":{"sense":"Talent","senseAmount":8,"cardChoices":3}}],"characters":[],"metCharacters":["tezuka_saki"]},{"id":"ROMANCE","choicePrompt":"","background":"","lines":[{"kind":"narration","speaker":"","text":"你坐在桌前，安静地翻阅着手中的书。读到一半，旁边传来的交谈声让你的目光停在了纸页上。","portrait":"","background":"","portraitLayout":null,"characters":null},{"kind":"dialogue","speaker":"金发独眼少女","text":"小希，果然还是和你待在一起最安心了啊。","portrait":"","background":"","portraitLayout":{"x":47.1,"y":679.8,"size":184,"imageScale":1.5,"imageOffsetX":1.2,"imageOffsetY":44.3},"characters":[{"id":"CHARACTER","image":"res://images/story/8613b62c85505198d18d.png","x":529.1,"y":928.9,"height":820,"flipX":false,"opacity":1}]},{"kind":"dialogue","speaker":"戴眼镜的发型很危险的少女","text":"……你刚才可不是这么说的吧。","portrait":"","background":"","portraitLayout":null,"characters":[{"id":"CHARACTER","image":"res://images/story/8613b62c85505198d18d.png","x":579.7,"y":910.9,"height":820,"flipX":false,"opacity":1},{"id":"CHARACTER_2","image":"res://images/story/cae0793d2d73e35fb623.png","x":1034.8,"y":918,"height":820,"flipX":false,"opacity":1}]},{"kind":"dialogue","speaker":"金发独眼少女","text":"因为我们都和普通女孩子不太一样嘛。","portrait":"","background":"","portraitLayout":{"x":47.1,"y":679.8,"size":184,"imageScale":1.5,"imageOffsetX":1.2,"imageOffsetY":44.3},"characters":[{"id":"CHARACTER","image":"res://images/story/6c295023aef890921773.png","x":579.7,"y":910.9,"height":820,"flipX":false,"opacity":1},{"id":"CHARACTER_2","image":"res://images/story/fc00b80636551994292e.png","x":1034.8,"y":918,"height":820,"flipX":false,"opacity":1}]},{"kind":"dialogue","speaker":"戴眼镜的发型很危险的少女","text":"别一副理所当然的样子把我也算进去啊！","portrait":"","background":"","portraitLayout":{"x":47.1,"y":679.8,"size":184,"imageScale":1.5,"imageOffsetX":1.2,"imageOffsetY":134.6},"characters":[{"id":"CHARACTER","image":"res://images/story/6c295023aef890921773.png","x":579.7,"y":910.9,"height":820,"flipX":false,"opacity":1},{"id":"CHARACTER_2","image":"res://images/story/b1ca28cb9b5380524efd.png","x":1034.8,"y":918,"height":820,"flipX":false,"opacity":1}]},{"kind":"narration","speaker":"","text":"你循声望去。戴着眼镜的少女正皱着眉头，另一位短发少女却笑得毫无反省之意，反而又往她身边凑了凑。","portrait":"","background":"","portraitLayout":null,"characters":[{"id":"CHARACTER","image":"res://images/story/6c295023aef890921773.png","x":832.5,"y":910.9,"height":581,"flipX":false,"opacity":1},{"id":"CHARACTER_2","image":"res://images/story/314c965ad5194b4acafb.png","x":1060.1,"y":910.8,"height":581,"flipX":false,"opacity":1}]},{"kind":"thought","speaker":"","text":"（……都被这样说了，还能笑得这么开心啊。）","portrait":"","background":"","portraitLayout":null,"characters":[]},{"kind":"narration","speaker":"","text":"你垂下眼睛，试着继续阅读，唇角却不自觉地弯了起来。","portrait":"","background":"","portraitLayout":null,"characters":null},{"kind":"thought","speaker":"","text":"（这种时候，越是搭理她，她就越得意呢。）","portrait":"","background":"","portraitLayout":null,"characters":null},{"kind":"thought","speaker":"","text":"（可要是真的不理她，又会凑过来问个不停……）","portrait":"","background":"","portraitLayout":null,"characters":null},{"kind":"narration","speaker":"","text":"翻页的动作忽然停住了。","portrait":"","background":"","portraitLayout":null,"characters":null},{"kind":"thought","speaker":"","text":"（……她？）","portrait":"","background":"","portraitLayout":null,"characters":null},{"kind":"narration","speaker":"","text":"你明明是在看旁边那两个人，却不知从什么时候起，想到了另一个人。","portrait":"","background":"","portraitLayout":null,"characters":null},{"kind":"narration","speaker":"","text":"脑海中隐约掠过一抹粉色。似乎也有谁，总喜欢这样凑到你的身边，说些让人不知该如何回答的话。","portrait":"","background":"","portraitLayout":null,"characters":null},{"kind":"narration","speaker":"","text":"而你大概也曾像那位戴眼镜的少女一样，皱着眉头，叹着气——却始终没有挪开身旁的位置。","portrait":"","background":"","portraitLayout":null,"characters":null},{"kind":"thought","speaker":"","text":"（……真是的。稍微安静一会儿，不行么。）","portrait":"","background":"","portraitLayout":null,"characters":null},{"kind":"narration","speaker":"","text":"这个念头自然得，仿佛下一刻就该有人笑着回应。","portrait":"","background":"","portraitLayout":null,"characters":null},{"kind":"narration","speaker":"","text":"可你等了片刻，什么也没有想起来。","portrait":"","background":"","portraitLayout":null,"characters":null},{"kind":"thought","speaker":"","text":"（……我是在对谁说话呢。）","portrait":"","background":"","portraitLayout":null,"characters":null},{"kind":"narration","speaker":"","text":"旁边的拌嘴还在继续。你低下头，同一行文字已经看了好几遍，却一个字也没能读进去。","portrait":"","background":"","portraitLayout":null,"characters":null},{"kind":"thought","speaker":"","text":"（应该……是经常待在一起的人吧。）","portrait":"","background":"","portraitLayout":null,"characters":null},{"kind":"thought","speaker":"","text":"（不然，为什么连她会怎么惹我生气，都像是记得一样……）","portrait":"","background":"","portraitLayout":null,"characters":null},{"kind":"narration","speaker":"","text":"你试着看清那抹粉色，脑海中却骤然传来一阵刺痛。","portrait":"","background":"res://images/story/ae18a9c23d806d4f878b.png","portraitLayout":null,"characters":null},{"kind":"narration","speaker":"","text":"再次睁眼，面前已是塔内冰冷的墙壁。","portrait":"","background":"res://images/story/94f82a588fa5f0bb389a.png","portraitLayout":null,"characters":null},{"kind":"narration","speaker":"","text":"那些吵吵闹闹的声音消失了。四周终于安静下来，你却下意识地看了一眼身旁。","portrait":"","background":"","portraitLayout":null,"characters":null},{"kind":"narration","speaker":"","text":"那里空无一人。","portrait":"","background":"","portraitLayout":null,"characters":null},{"kind":"thought","speaker":"","text":"（……明明，也没有真的嫌你吵啊。）","portrait":"","background":"","portraitLayout":null,"characters":null},{"kind":"thought","speaker":"","text":"（所以，至少让我想起……你的名字吧。）","portrait":"","background":"","portraitLayout":null,"characters":null}],"choices":[{"id":"TAKE_REWARD","text":"精神＋8，从3张卡牌中选择1张获得。","description":"精神＋8，从3张卡牌中选择1张获得。","nextPage":"FINISHED","rewards":{"sense":"MentalStrength","senseAmount":8,"cardChoices":3}}],"characters":[],"metCharacters":["ruka","yuki"]},{"id":"MUTSUMI","choicePrompt":"读些什么呢？","background":"","lines":[{"kind":"thought","speaker":"","text":"（继续前进吧。）","portrait":"","background":"res://images/story/94f82a588fa5f0bb389a.png","portraitLayout":null,"characters":null},{"kind":"thought","speaker":"丰川祥子","text":"（我一定会找到你们的。）","portrait":"","background":"","portraitLayout":null,"characters":null}],"choices":[],"characters":[],"metCharacters":["mutsumi"]},{"id":"FINISHED","choicePrompt":"读些什么呢？","background":"","lines":[{"kind":"thought","speaker":"","text":"（继续前进吧。）","portrait":"","background":"res://images/story/94f82a588fa5f0bb389a.png","portraitLayout":null,"characters":null},{"kind":"thought","speaker":"丰川祥子","text":"（我一定会找到你们的。）","portrait":"","background":"","portraitLayout":null,"characters":null}],"choices":[],"characters":[]}]},"narvy":{"schemaVersion":1,"id":"NARVY_HBRGO_SAKI","title":"██广场","eventPool":"memoryFragments","conditions":{"partyCharacters":["HbrgoSaki31O","HbrgoSaki30A","HbrgoHotaru"],"acts":[],"oncePerRun":true,"afterEventIds":["JOINING_CEREMONY_HBRGO_SAKI"]},"presentation":{"background":"res://images/events/hbrgo_saki_mod_event_library_hbrgo_saki.png","dialogueStyle":"original","choicePortrait":"res://images/characters/hbrgo_saki_normal.png","thoughtPortrait":"","portraitLayout":{"x":46,"y":672,"size":184,"imageScale":1,"imageOffsetX":0,"imageOffsetY":0}},"startPage":"INITIAL","pages":[{"id":"INITIAL","choicePrompt":"做些什么呢","background":"res://images/story/c96da969cdec9aca63d5.png","lines":[{"kind":"narration","speaker":"","text":"又一场战斗结束后，你的脑袋突然剧烈的疼痛起来。","portrait":"","background":"res://images/story/0e7852eda2e600c2faa4.png","portraitLayout":null,"characters":null},{"kind":"narration","speaker":"","text":"闭上眼，再睁开时，你发现自己竟然身处一片有着许多黑色史莱姆状生物的广场？","portrait":"","background":"res://images/story/c96da969cdec9aca63d5.png","portraitLayout":null,"characters":null},{"kind":"narration","speaker":"","text":"不知为何，你在它们身上感到了亲近感，让你完全提不起防备。","portrait":"","background":"","portraitLayout":null,"characters":null}],"choices":[{"id":"CHOICE","text":"让██笑一笑","description":"温柔＋8，从3张卡牌中选择1张获得。","nextPage":"SCENE","rewards":{"sense":"","senseAmount":0,"cardChoices":0}},{"id":"CHOICE_2","text":"教██一些杂技吧","description":"","nextPage":"SCENE_3","rewards":{"sense":"","senseAmount":0,"cardChoices":0}},{"id":"CHOICE_3","text":"素世","description":"","nextPage":"SCENE_4","rewards":{"sense":"","senseAmount":0,"cardChoices":0}},{"id":"CHOICE_TAMA","text":"国见玉","description":"领袖魅力+8，从3张卡牌中选择1张获得。","nextPage":"TAMA","rewards":{"sense":"","senseAmount":0,"cardChoices":0}}],"characters":[]},{"id":"SCENE","title":"让██笑一笑","choicePrompt":"","background":"","lines":[{"kind":"thought","speaker":"丰川祥子","text":"（……好，就让它们笑一笑吧。）","portrait":"","background":"res://images/story/c96da969cdec9aca63d5.png","portraitLayout":null,"characters":null},{"kind":"narration","speaker":"","text":"这个念头毫无来由地浮上心头。你甚至已经想好了该怎么做，随后才感到一丝困惑。","portrait":"","background":"","portraitLayout":null,"characters":null},{"kind":"thought","speaker":"丰川祥子","text":"（……奇怪。我以前，也做过这样的事么？）","portrait":"","background":"","portraitLayout":null,"characters":null},{"kind":"narration","speaker":"","text":"眼前忽然闪过几个零碎的画面。","portrait":"","background":"","portraitLayout":null,"characters":null},{"kind":"narration","speaker":"","text":"你蹲在那些小小的生物面前，伸出手逗弄着它们。那抹粉色就在身旁，随着笑声轻轻晃动。","portrait":"","background":"","portraitLayout":null,"characters":null},{"kind":"dialogue","speaker":"助手？","text":"丰川同学，你在和██玩吗？","portrait":"","background":"","portraitLayout":null,"characters":null},{"kind":"narration","speaker":"","text":"近在耳边的声音将你从回忆中唤了回来。","portrait":"","background":"","portraitLayout":null,"characters":null},{"kind":"narration","speaker":"","text":"你循声抬头，面前的女性正看着你，似乎在等你的回答。","portrait":"","background":"","portraitLayout":null,"characters":[{"id":"CHARACTER","image":"res://images/story/5fe0a2b5ea02e07f64d7.png","x":810.9,"y":1488.7,"height":1450,"flipX":false,"opacity":1}]},{"kind":"thought","speaker":"丰川祥子","text":"（……这位是，入队仪式时站在那位紫发女性身旁的人。）","portrait":"","background":"","portraitLayout":null,"characters":null},{"kind":"thought","speaker":"丰川祥子","text":"（记得……似乎是她的助手。）","portrait":"","background":"","portraitLayout":null,"characters":null},{"kind":"dialogue","speaker":"丰川祥子","text":"……请问，您认识我？","portrait":"","background":"","portraitLayout":null,"characters":null},{"kind":"narration","speaker":"","text":"女性微微一怔，随即露出有些无奈的神情。","portrait":"","background":"","portraitLayout":null,"characters":[{"id":"CHARACTER","image":"res://images/story/fb54f16f74a6bd4422ed.png","x":810.9,"y":1488.7,"height":1450,"flipX":false,"opacity":1}]},{"kind":"dialogue","speaker":"助手？","text":"又在和茅森同学玩什么游戏吗？","portrait":"","background":"","portraitLayout":null,"characters":[{"id":"CHARACTER","image":"res://images/story/5fe0a2b5ea02e07f64d7.png","x":810.9,"y":1488.7,"height":1450,"flipX":false,"opacity":1}]},{"kind":"dialogue","speaker":"助手？","text":"██同学，我是——","portrait":"","background":"","portraitLayout":null,"characters":null},{"kind":"narration","speaker":"","text":"熟悉的刺痛骤然袭来。","portrait":"","background":"res://images/story/b04f3c2031329c67643b.png","portraitLayout":null,"characters":null},{"kind":"narration","speaker":"","text":"你下意识地按住额角，努力想听清她接下来的话，眼前的身影却已经模糊起来。","portrait":"","background":"","portraitLayout":null,"characters":[{"id":"CHARACTER","image":"res://images/story/5fe0a2b5ea02e07f64d7.png","x":810.9,"y":1488.7,"height":1450,"flipX":false,"opacity":0.7}]},{"kind":"thought","speaker":"丰川祥子","text":"（……请等一下。我还没有——）","portrait":"","background":"","portraitLayout":null,"characters":[{"id":"CHARACTER","image":"res://images/story/5fe0a2b5ea02e07f64d7.png","x":810.9,"y":1488.7,"height":1450,"flipX":false,"opacity":0.3}]},{"kind":"narration","speaker":"","text":"再次睁眼，面前只剩下塔内冰冷的墙壁。","portrait":"","background":"res://images/story/94f82a588fa5f0bb389a.png","portraitLayout":null,"characters":[]},{"kind":"thought","speaker":"丰川祥子","text":"（又是这样......）","portrait":"","background":"","portraitLayout":null,"characters":null}],"choices":[{"id":"CHOICE","text":"温柔＋8，从3张卡牌中选择1张获得。","description":"温柔＋8，从3张卡牌中选择1张获得。","nextPage":"SCENE_2","rewards":{"sense":"Gentleness","senseAmount":8,"cardChoices":3}}],"characters":[],"metCharacters":["nanami"]},{"id":"SCENE_3","title":"教██一些杂技吧","choicePrompt":"","background":"","lines":[{"kind":"thought","speaker":"丰川祥子","text":"（……好，就教它们一些杂技吧。）","portrait":"","background":"res://images/story/c96da969cdec9aca63d5.png","portraitLayout":null,"characters":null},{"kind":"thought","speaker":"丰川祥子","text":"（不过，教些什么才好呢……）","portrait":"","background":"","portraitLayout":null,"characters":null},{"kind":"thought","speaker":"丰川祥子","text":"（……有了。）","portrait":"","background":"","portraitLayout":null,"characters":null},{"kind":"dialogue","speaker":"丰川祥子","text":"千早同学？","portrait":"","background":"","portraitLayout":null,"characters":null},{"kind":"narration","speaker":"","text":"蓝与金的双刀从空中的虫洞里落下，稳稳地落入你手中。","portrait":"","background":"","portraitLayout":null,"characters":null},{"kind":"narration","speaker":"","text":"你将蓝色的长刀放在一旁，右手握住金色的短刀，左手虚托在身前，仿佛正托着什么东西。","portrait":"","background":"","portraitLayout":null,"characters":null},{"kind":"narration","speaker":"","text":"随后，你神情认真地削起了手中的空气。","portrait":"","background":"","portraitLayout":null,"characters":null},{"kind":"dialogue","speaker":"？？？","text":"喂，丰川！你搞啥啊？！","portrait":"","background":"","portraitLayout":null,"characters":null},{"kind":"dialogue","speaker":"？？？","text":"为啥在██广场把炽天使召出来了，还在那儿削来削去的？","portrait":"","background":"","portraitLayout":null,"characters":null},{"kind":"narration","speaker":"","text":"你停下动作，看向声音传来的方向。","portrait":"","background":"","portraitLayout":null,"characters":[{"id":"CHARACTER","image":"res://images/story/25d626445832af3abab3.png","x":800,"y":1300.8,"height":1286,"flipX":false,"opacity":1}]},{"kind":"dialogue","speaker":"丰川祥子","text":"我在教它们做刀削面。","portrait":"","background":"","portraitLayout":null,"characters":null},{"kind":"dialogue","speaker":"粉色的关西腔少女","text":"……刀削面？","portrait":"","background":"","portraitLayout":null,"characters":[{"id":"CHARACTER","image":"res://images/story/c46ad72ed1200b5523a8.png","x":800,"y":1300.8,"height":1286,"flipX":false,"opacity":1}]},{"kind":"dialogue","speaker":"丰川祥子","text":"你没听说过么？","portrait":"","background":"","portraitLayout":null,"characters":null},{"kind":"narration","speaker":"","text":"你略显意外，随即耐心地解释起来。","portrait":"","background":"","portraitLayout":null,"characters":null},{"kind":"dialogue","speaker":"丰川祥子","text":"就是一只手拿着面团，另一只手里拿刀，站在开水锅前，把面团削成细长的薄片下进锅里煮的面！","portrait":"","background":"","portraitLayout":null,"characters":null},{"kind":"dialogue","speaker":"粉色的关西腔少女","text":"谁问你面要怎么做了啊！","portrait":"","background":"","portraitLayout":null,"characters":[{"id":"CHARACTER","image":"res://images/story/25d626445832af3abab3.png","x":800,"y":1300.8,"height":1286,"flipX":false,"opacity":1}]},{"kind":"narration","speaker":"","text":"你的手停在了半空。","portrait":"","background":"","portraitLayout":null,"characters":null},{"kind":"dialogue","speaker":"粉色的关西腔少女","text":"咱问的是，为什么要召唤炽天使！削个面需要用到那种东西吗？！","portrait":"","background":"","portraitLayout":null,"characters":null},{"kind":"dialogue","speaker":"丰川祥子","text":"……欸？","portrait":"","background":"","portraitLayout":null,"characters":null},{"kind":"narration","speaker":"","text":"话音刚落，熟悉的刺痛骤然袭来。","portrait":"","background":"res://images/story/0e7852eda2e600c2faa4.png","portraitLayout":null,"characters":[{"id":"CHARACTER","image":"res://images/story/25d626445832af3abab3.png","x":800,"y":1300.8,"height":1286,"flipX":false,"opacity":0.7}]},{"kind":"narration","speaker":"","text":"再次睁眼，面前只剩下塔内冰冷的墙壁。","portrait":"","background":"res://images/story/94f82a588fa5f0bb389a.png","portraitLayout":null,"characters":[]},{"kind":"narration","speaker":"","text":"你低头看了看空空的左手。","portrait":"","background":"","portraitLayout":null,"characters":null},{"kind":"thought","speaker":"丰川祥子","text":"（……说起来，我为什么会知道这种面的做法呢？）","portrait":"","background":"","portraitLayout":null,"characters":null},{"kind":"thought","speaker":"丰川祥子","text":"（连手上的动作，都记得这样清楚……）","portrait":"","background":"","portraitLayout":null,"characters":null},{"kind":"narration","speaker":"","text":"你试着回想了一会儿，最终轻轻叹了口气。","portrait":"","background":"","portraitLayout":null,"characters":null},{"kind":"thought","speaker":"丰川祥子","text":"（下次若是有材料，就试着做一碗吧。）","portrait":"","background":"","portraitLayout":null,"characters":null}],"choices":[{"id":"CHOICE","text":"疯狂＋8，从3张卡牌中选择1张获得。","description":"疯狂＋8，从3张卡牌中选择1张获得。","nextPage":"SCENE_2","rewards":{"sense":"Madness","senseAmount":8,"cardChoices":3}}],"characters":[],"metCharacters":["megumi"]},{"id":"SCENE_4","title":"素世","choicePrompt":"","background":"res://images/story/c96da969cdec9aca63d5.png","lines":[],"choices":[{"id":"CHOICE","text":"单纯＋8，从3张卡牌中选择1张获得。亚麻色长发的少女进入了记忆之庭","description":"单纯＋8，从3张卡牌中选择1张获得。亚麻色长发的少女进入了记忆之庭","nextPage":"SCENE_2","rewards":{"sense":"Simplicity","senseAmount":8,"cardChoices":3}}],"characters":[],"metCharacters":["soyo"]},{"id":"TAMA","title":"国见玉","choicePrompt":"","background":"","lines":[{"kind":"narration","speaker":"","text":"国见玉","portrait":"","background":"","portraitLayout":null,"characters":null}],"characters":[],"metCharacters":["tama"],"choices":[{"id":"TAKE_REWARD","text":"领袖魅力+8，从3张卡牌中选择1张获得。","description":"领袖魅力+8，从3张卡牌中选择1张获得。","nextPage":"SCENE_2","rewards":{"sense":"LeadershipCharm","senseAmount":8,"cardChoices":3}}]},{"id":"SCENE_2","title":"结尾","choicePrompt":"","background":"","lines":[{"kind":"thought","speaker":"丰川祥子","text":"（继续前进吧。）","portrait":"","background":"res://images/story/94f82a588fa5f0bb389a.png","portraitLayout":null,"characters":null},{"kind":"thought","speaker":"丰川祥子","text":"（我一定会找到你们的。）","portrait":"","background":"","portraitLayout":null,"characters":null}],"choices":[],"characters":[]}]},"studio":{"schemaVersion":1,"id":"STUDIO_HBRGO_SAKI","title":"录音室","eventPool":"memoryFragments","conditions":{"partyCharacters":["HbrgoSaki31O","HbrgoSaki30A","HbrgoHotaru"],"acts":[],"oncePerRun":true,"afterEventIds":["JOINING_CEREMONY_HBRGO_SAKI"]},"presentation":{"background":"res://images/story/70208cc9205d632aae30.png","dialogueStyle":"original","choicePortrait":"","thoughtPortrait":"","portraitLayout":{"x":46,"y":672,"size":184,"imageScale":1,"imageOffsetX":0,"imageOffsetY":0}},"startPage":"INITIAL","pages":[{"id":"INITIAL","choicePrompt":"回忆起谁呢？","background":"","lines":[{"kind":"narration","speaker":"","text":"录音室","portrait":"","background":"","portraitLayout":null,"characters":null}],"choices":[{"id":"CHOICE","text":"千早爱音","description":"才能+8，从3张卡牌中选择1张获得","nextPage":"ANON","rewards":{"sense":"","senseAmount":0,"cardChoices":0}},{"id":"CHOICE_TSUKASA","text":"东城司","description":"疯狂+8，从3张卡牌中选择1张获得。","nextPage":"TSUKASA","rewards":{"sense":"","senseAmount":0,"cardChoices":0}}],"characters":[]},{"id":"ANON","choicePrompt":"","background":"","lines":[{"kind":"narration","speaker":"","text":"爱音","portrait":"","background":"","portraitLayout":null,"characters":null}],"choices":[{"id":"CHOICE","text":"才能+8，从3张卡牌中选择1张获得","description":"才能+8，从3张卡牌中选择1张获得","nextPage":"SCENE","rewards":{"sense":"Talent","senseAmount":8,"cardChoices":3}}],"characters":[],"metCharacters":["anon"],"title":"千早爱音"},{"id":"TSUKASA","title":"东城司","choicePrompt":"","background":"","lines":[{"kind":"narration","speaker":"","text":"东城司","portrait":"","background":"","portraitLayout":null,"characters":null}],"characters":[],"metCharacters":["tsukasa"],"choices":[{"id":"TAKE_REWARD","text":"疯狂+8，从3张卡牌中选择1张获得。","description":"疯狂+8，从3张卡牌中选择1张获得。","nextPage":"SCENE","rewards":{"sense":"Madness","senseAmount":8,"cardChoices":3}}]},{"id":"SCENE","title":"ENDING","choicePrompt":