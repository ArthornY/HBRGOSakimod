<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The linked mod sources are written for the mod's nullable-disabled context. -->
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <!-- Only the plain .NET half of the feature: no Godot, no game assembly. -->
    <Compile Include="../../Core/RunUpload/Common/*.cs" LinkBase="RunUpload" />
    <!-- The OD gauge's request is plain .NET too (payload and whose OD opens). -->
    <Compile Include="../../Core/Integration/HbrOverclockActivation.cs" Link="Integration/HbrOverclockActivation.cs" />
    <None Include="fixtures/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
