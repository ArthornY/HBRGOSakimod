  "pages": [
    {
      "id": "INITIAL",
      "choicePrompt": "做些什么呢",
      "background": "res://images/story/c96da969cdec9aca63d5.png",
      "lines": [
        {
          "kind": "narration",
          "speaker": "",
          "text": "又一场战斗结束后，你的脑袋突然剧烈的疼痛起来。",
          "portrait": "",
          "background": "res://images/story/0e7852eda2e600c2faa4.png",
          "portraitLayout": null,
          "characters": null
        },
        {
          "kind": "narration",
          "speaker": "",
          "text": "闭上眼，再睁开时，你发现自己竟然身处一片有着许多黑色史莱姆状生物的广场？",
          "portrait": "",
          "background": "res://images/story/c96da969cdec9aca63d5.png",
          "portraitLayout": null,
          "characters": null
        },
        {
          "kind": "narration",
          "speaker": "",
          "text": "不知为何，你在它们身上感到了亲近感，让你完全提不起防备。",
          "portrait": "",
          "background": "",
          "portraitLayout": null,
          "characters": null
        }
      ],
      "choices": [
        {
          "id": "CHOICE",
          "text": "让██笑一笑",
          "description": "温柔＋8，从3张卡牌中选择1张获得。",
          "nextPage": "SCENE",
          "rewards": {
            "sense": "",
            "senseAmount": 0,
            "cardChoices": 0
          }
        },
        {
          "id": "CHOICE_2",
