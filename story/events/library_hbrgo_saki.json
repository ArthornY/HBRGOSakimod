  "pages": [
    {
      "id": "INITIAL",
      "choicePrompt": "读些什么呢？",
      "background": "",
      "lines": [
        {
          "kind": "narration",
          "speaker": "",
          "text": "又一场战斗结束后，你的脑袋突然剧烈的疼痛起来。",
          "portrait": "",
          "background": "res://images/story/ae18a9c23d806d4f878b.png",
          "portraitLayout": null,
          "characters": []
        },
        {
          "kind": "narration",
          "speaker": "",
          "text": "闭上眼，再睁开时，你发现自己竟然身处一座图书馆？",
          "portrait": "",
          "background": "res://images/events/hbrgo_saki_mod_event_library_hbrgo_saki.png",
          "portraitLayout": null,
          "characters": null
        },
        {
          "kind": "narration",
          "speaker": "",
          "text": "你下意识的从面前的书架上拿起了一本书。",
          "portrait": "",
          "background": "",
          "portraitLayout": null,
          "characters": null
        }
      ],
      "choices": [
        {
          "id": "PETS",
          "text": "杂志（宠物特辑）",
